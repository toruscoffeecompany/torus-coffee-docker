# Torus Fleet Environment Template
# Copy to .env and fill in real values.
# Do NOT commit .env.

# Shared
TZ=America/Chicago
OBSIDIAN_VAULT=D:/Work/Torus Coffee Company LLC
REDIS_PASSWORD=

# Alert Router
ALERT_CHANNEL=#torus-coffee
DISCORD_WEBHOOK=
TORUS_DISCORD_WEBHOOK=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=alerts@toruscoffeecompany.local
ALERT_ROUTER_API_TOKEN=change-me

# Dashboard
DASHBOARD_SECRET=change-me

# Inventory
INVENTORY_API_KEY=change-me
INVENTORY_PORT=3200

# POS
POS_TERMINAL_ID=PINKCADY-01
POS_PORT=3100

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Grafana
GRAFANA_PASSWORD=admin
